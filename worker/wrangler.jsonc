{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kristina-career-leads",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://guzhvacareer.ru"
  },
  "observability": {
    "enabled": true
  }

  // Опциональная защита от частых повторных заявок.
  // Раскомментируйте и задайте уникальный namespace_id в своем Cloudflare-аккаунте.
  // "ratelimits": [
  //   {
  //     "name": "LEAD_RATE_LIMITER",
  //     "namespace_id": "1001",
  //     "simple": { "limit": 3, "period": 60 }
  //   }
  // ]
}
